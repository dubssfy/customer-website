# ========================================
# FRONTEND (.env)
# Create a .env file in the root directory (c:\Users\91755\Desktop\Swaccham\my-react-app)
# ========================================

VITE_API_URL=http://localhost:5000/api

# ========================================
# BACKEND (server/.env)
# Create a .env file in the server directory
# ========================================

PORT=5000
NODE_ENV=development

# Database Configuration (Neon PostgreSQL)
# Example: postgresql://[user]:[password]@[neon_hostname]/[dbname]?sslmode=require
DATABASE_URL=your_neon_postgres_connection_string_here

# Email Configuration (Nodemailer - e.g., Gmail App Password)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_character_app_password
